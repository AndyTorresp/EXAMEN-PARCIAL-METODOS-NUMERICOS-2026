import numpy as np
import matplotlib.pyplot as plt

# 1. DATOS EXPERIMENTALES DEL LABORATORIO
f = np.array([100, 120, 150, 170, 200, 240, 270, 310, 360, 410, 460, 520, 580, 655, 730, 810, 890, 990, 1080, 1190, 1290, 1410, 1540, 1690, 1840, 1990, 2160, 2340, 2530, 2730], dtype=float)
Z = np.array([152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.0, 134.8, 133.6, 132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, 135.2, 136.9, 138.8, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2], dtype=float)

print("--- EJECUTANDO INTERPOLACIÓN POLINÓMICA GLOBAL (GRADO 29) ---")

# 2. MÉTODO MATRICIAL (Construcción de la Matriz de Vandermonde)
print("\n[1] Intentando resolver por Método Matricial...")
try:
    V = np.vander(f, increasing=True)
    # Intentamos resolver V * a = Z de forma directa
    coef_matricial = np.linalg.solve(V, Z)
    print("> Matriz invertida. Coeficientes calculados (sujetos a severo error numérico).")
except np.linalg.LinAlgError:
    print("> Error: La matriz es singular o está tan mal condicionada que no se puede invertir.")

# 3. ALGORITMO DE INTERPOLACIÓN DE LAGRANGE (Grado 29)
def interpolacion_lagrange(x_eval, x_nodos, y_nodos):
    n = len(x_nodos)
    resultado = 0
    for i in range(n):
        termino = y_nodos[i]
        for j in range(n):
            if i != j:
                termino = termino * (x_eval - x_nodos[j]) / (x_nodos[i] - x_nodos[j])
        resultado += termino
    return resultado

# 4. GENERACIÓN DE CURVAS PARA GRAFICAR
# Creamos un eje de frecuencias continuo con 1000 puntos para ver el trazo real
f_continuo = np.linspace(f.min(), f.max(), 1000)

print("\n[2] Calculando curva continua por Método de Lagrange...")
Z_lagrange = np.array([interpolacion_lagrange(x, f, Z) for x in f_continuo])
print("> Curva de Lagrange procesada exitosamente.")

# 5. CONSTRUCCIÓN DE LA GRÁFICA PARA EL INFORME
plt.figure(figsize=(10, 6))
plt.scatter(f, Z, color='red', edgecolor='black', s=45, zorder=5, label='Datos medidos (Nodos)')
plt.plot(f_continuo, Z_lagrange, color='blue', linestyle='-', linewidth=1.5, label='Polinomio Global Grado 29 (Lagrange / Matricial)')

plt.title('Parte B.1: Interpolación Polinómica Global sobre todo el Rango')
plt.xlabel('Frecuencia f (Hz)')
plt.ylabel('Impedancia |Z| (Ohm)')

# Ajustamos los límites de visualización en Y para contener el gráfico
plt.ylim(100, 180) 
plt.grid(True, linestyle='--', alpha=0.6)
plt.legend(loc='upper center')
plt.show()
