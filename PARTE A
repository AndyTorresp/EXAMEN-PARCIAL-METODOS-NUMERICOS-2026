import matplotlib.pyplot as plt
import numpy as np

# --- 1. DATOS DE ENTRADA ---
f = [100, 120, 150, 170, 200, 240, 270, 310, 360, 410, 460, 520, 590, 
     660, 740, 810, 900, 980, 1080, 1190, 1290, 1410, 1540, 1690, 
     1830, 1990, 2160, 2340, 2530, 2740]

Z = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 
     133.6, 132.7, 132.0, 131.4, 131.1, 131.0, 131.0, 131.3, 132.0, 
     132.7, 133.8, 135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 
     152.2, 155.6, 159.2]

# --- 2. CREACIÓN DE LA GRÁFICA ---
# Configurar figura con fondo blanco y tamaño adecuado
plt.figure(figsize=(7, 4.5), facecolor='white')

# Graficar los puntos (círculos rojos con borde negro y grosor de borde 0.8)
plt.plot(f, Z, 'ro', markerfacecolor='red', markeredgecolor='black', markeredgewidth=0.8, label='Datos medidos')

# --- 3. CONFIGURACIÓN DE EJES Y CUADRÍCULA ---
plt.grid(True, linestyle='--', color='gray', alpha=0.5)

# Ajustar límites de los ejes exactamente como la imagen original
plt.xlim(0, 2900)
plt.ylim(129, 161)

# Ajustar las marcas de los ejes (Ticks) para que se parezcan a MATLAB
plt.xticks(np.arange(0, 3000, 500))
plt.yticks(np.arange(130, 165, 5))

# --- 4. TEXTOS Y ETIQUETAS ---
plt.title('Parte A: Análisis Exploratorio de Datos Medidos |Z| vs f', fontsize=11, fontweight='bold', pad=10)
plt.xlabel('Frecuencia f (Hz)', fontsize=10)
plt.ylabel('Impedancia |Z| (Ohm)', fontsize=10)

# Leyenda en la esquina superior izquierda
plt.legend(loc='upper left', frameon=True)

# Mostrar la gráfica de forma limpia
plt.show()
