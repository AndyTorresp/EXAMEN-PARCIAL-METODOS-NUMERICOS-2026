import numpy as np
from scipy.interpolate import CubicSpline
from numpy.polynomial import Polynomial

# Vectores de datos del laboratorio
f = np.array([100, 120, 145, 170, 200, 235, 270, 310, 355, 405, 460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, 1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730], dtype=float)
Z = np.array([152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, 132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, 135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2], dtype=float)

f_eval = 1000.0

# % Evaluación exacta mediante el Spline Cúbico (Equivalente a spline de MATLAB)
cs = CubicSpline(f, Z, bc_type='not-a-knot')
Z_spline_1000 = cs(f_eval)

# % Evaluación exacta mediante el Polinomio de Grado 10 (Equivalente a polyfit con mu de MATLAB)
p10 = Polynomial.fit(f, Z, deg=10)
Z_poli_1000 = p10(f_eval)

# % Impresión limpia de resultados para la tabla del informe
print('---------------------------------------------------------')
print('   VALORES OBTENIDOS INTERPOLADOS EN f = 1000 Hz')
print('---------------------------------------------------------')
print(f'Resultado con Spline Cúbico:         {Z_spline_1000:.4f} Ohmios')
print(f'Resultado con Polinomio Seleccionado: {Z_poli_1000:.4f} Ohmios')
print(f'Diferencia absoluta real calculada:  {abs(Z_spline_1000 - Z_poli_1000):.4f} Ohmios')
print('---------------------------------------------------------')
