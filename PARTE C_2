import numpy as np
from scipy.interpolate import CubicSpline

# Datos experimentales del laboratorio
f = np.array([100, 120, 145, 170, 200, 235, 270, 310, 355, 405, 460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, 1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730], dtype=float)
Z = np.array([152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, 132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, 135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2], dtype=float)

# Frecuencia del mínimo calculada previamente por el grupo
f_minimo = 742.1585

# 1. Construcción del Spline Cúbico exacto (Not-a-knot)
cs = CubicSpline(f, Z, bc_type='not-a-knot')

# 2. Derivación analítica utilizando las funciones integradas de SciPy
primera_derivada = cs.derivative(nu=1)
segunda_derivada = cs.derivative(nu=2)

# 3. Evaluación analítica en el punto crítico
dZ_df_en_min = primera_derivada(f_minimo)
d2Z_df2_en_min = segunda_derivada(f_minimo)

# Determinar tipo de estabilidad según el signo de la curvatura
estabilidad = "Mínimo Local Estable" if d2Z_df2_en_min > 0 else "Máximo/Inestable"

# Generación del reporte formal de resultados
print("---------------------------------------------------------")
print("        CÁLCULO ANALÍTICO DE LA SEGUNDA DERIVADA")
print("---------------------------------------------------------")
print(f"Frecuencia crítica evaluada:       {f_minimo:.4f} Hz")
print(f"Valor de la 1ra Derivada (d|Z|/df): {dZ_df_en_min:.6f} Ohm/Hz")
print(f"Valor de la 2da Derivada (d2|Z|/df2): {d2Z_df2_en_min:.6f} Ohm/Hz²")
print(f"Evaluación del signo (Curvatura):   {'+' if d2Z_df2_en_min > 0 else ''}{d2Z_df2_en_min:.6f} (> 0)")
print(f"Análisis de estabilidad matemática: {estabilidad}")
print("---------------------------------------------------------")
