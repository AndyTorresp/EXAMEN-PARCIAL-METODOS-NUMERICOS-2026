import numpy as np

# Datos del laboratorio
f = np.array([100, 120, 150, 170, 200, 240, 270, 310, 360, 410, 460, 520, 580, 655, 730, 810, 890, 990, 1080, 1190, 1290, 1410, 1540, 1690, 1840, 1990, 2160, 2340, 2530, 2730], dtype=float)
Z = np.array([152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.0, 134.8, 133.6, 132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, 135.2, 136.9, 138.8, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2], dtype=float)

# 1. CÁLCULO DEL VALOR INTERPOLADO A 1000 Hz (Polinomio Grado 10)
grado_seleccionado = 10
coef_g10 = np.polyfit(f, Z, grado_seleccionado)
val_1000 = np.polyval(coef_g10, 1000)

print("--- RESULTADOS DE LOS CÁLCULOS ---")
print(f"Valor interpolado a f = 1000 Hz: {val_1000:.4f} Ohm\n")

# 2. VALIDACIÓN LEAVE-ONE-OUT (LOO) CON 5 PUNTOS ALEATORIOS
# Fijamos una semilla para que los resultados sean constantes al copiar
np.random.seed(42) 
indices_totales = np.arange(len(f))
indices_azar = np.random.choice(indices_totales, size=5, replace=False)

print(f"Puntos seleccionados al azar (índices de la tabla): {indices_azar}")

errores_relativos = []

# Algoritmo LOO cíclico
for idx in indices_azar:
    # Separamos el punto de prueba (test)
    f_test = f[idx]
    Z_test = Z[idx]
    
    # El resto de puntos entran al entrenamiento (train)
    f_train = np.delete(f, idx)
    Z_train = np.delete(Z, idx)
    
    # Construimos el polinomio de grado 10 omitiendo el punto actual
    coef_loo = np.polyfit(f_train, Z_train, grado_seleccionado)
    
    # Predecimos el valor en la frecuencia escondida
    Z_predicho = np.polyval(coef_loo, f_test)
    
    # Calculamos el error relativo porcentual de esta iteración
    err_rel = np.abs((Z_test - Z_predicho) / Z_test) * 100
    errores_relativos.append(err_rel)
    
    print(f"-> Omitiendo f = {f_test} Hz | Real: {Z_test} | Predicho: {Z_predicho:.4f} | Error: {err_rel:.4f}%")

error_promedio_loo = np.mean(errores_relativos)
print(f"\nError relativo promedio estimado por LOO: {error_promedio_loo:.4f}%")
