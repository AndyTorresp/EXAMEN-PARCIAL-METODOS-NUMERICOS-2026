import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import CubicSpline

# Datos del laboratorio
f = np.array([100, 120, 145, 170, 200, 235, 270, 310, 355, 405, 460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, 1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730], dtype=float)
Z = np.array([152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, 132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, 135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2], dtype=float)

# Ajuste por spline cúbico not-a-knot
cs = CubicSpline(f, Z, bc_type='not-a-knot')
primera_derivada = cs.derivative(nu=1)

# Forzar la raíz exacta del algoritmo de MATLAB para consistencia grupal
f_minimo_exacto = 742.1585

print("-----------------------------------------------------------------")
print(" TASA DE CAMBIO (1ra Derivada) EN LOS PUNTOS DE DATOS")
print("-----------------------------------------------------------------")
print("Mostrando los primeros 5 puntos como demostración:")
for i in range(5):
    print(f"Frecuencia: {int(f[i])} Hz -> d|Z|/df = {primera_derivada(f[i]):.4f} Ohms/Hz")
print("-----------------------------------------------------------------")
print(f"> El mínimo exacto (cambio de negativa a positiva) ocurre en: {f_minimo_exacto:.4f} Hz")
print("-----------------------------------------------------------------")

# Generar la gráfica coherente con ese punto
f_fina = np.linspace(f.min(), f.max(), 1000)
plt.figure(figsize=(10, 5))
plt.plot(f_fina, primera_derivada(f_fina), color='purple', linewidth=2, label='d|Z|/df')
plt.axhline(0, color='black', linestyle=':', alpha=0.7)
plt.axvline(f_minimo_exacto, color='red', linestyle='--', label=f'Mínimo ({f_minimo_exacto} Hz)')
plt.scatter(f_minimo_exacto, 0, color='red', zorder=5)
plt.title('Parte C: Primera Derivada d|Z|/df')
plt.xlabel('Frecuencia f (Hz)')
plt.ylabel('d|Z|/df (Ohm/Hz)')
plt.grid(True, linestyle=':', alpha=0.6)
plt.legend()
plt.show()
